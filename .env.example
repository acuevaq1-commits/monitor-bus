# Tablas existentes iislog/iisupao: usuario con permisos SELECT.
MONITOR_SOURCE_DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST:5432/integraciones_db
# Tablas propias iismonitor: usuario con permisos CREATE/SELECT/INSERT/UPDATE.
MONITOR_DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST:5432/integraciones_db
MONITOR_SESSION_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO
MONITOR_ADMIN_USER=admin
MONITOR_ADMIN_PASSWORD=CAMBIAR_CLAVE_ADMIN
MONITOR_ENVIRONMENT=Desarrollo
MONITOR_TIMEZONE=America/Lima

# API de monitorización SAP Integration Suite (MessageProcessingLogs/Attachments).
# Requiere MonitoringDataRead y MessagePayloadsRead en Cloud Foundry.
MONITOR_SAP_MPL_BASE_URL=https://upaoprd-cpi-kfocujol.integrationsuite.cfapps.us11.hana.ondemand.com
# Use oauth con URL del token, client ID y client secret de una service key,
# o basic con usuario y contraseña autorizados para la API de monitorización.
# Las credenciales de la URL /http/api/prd/business/partner son de ejecución y no sirven aquí.
MONITOR_SAP_MPL_AUTH_TYPE=oauth
MONITOR_SAP_MPL_TOKEN_URL=
MONITOR_SAP_MPL_CLIENT_ID=
MONITOR_SAP_MPL_CLIENT_SECRET=
MONITOR_SAP_MPL_USERNAME=
MONITOR_SAP_MPL_PASSWORD=
